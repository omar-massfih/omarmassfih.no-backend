PORT=8000
# Use a pooled Neon connection string for the serverless application.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require
# Auth for Vercel AI Gateway chat. Embeddings run locally and do not use this key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
CHAT_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_THREADS=2
CHAT_TOP_K=6
CHAT_GRAPH_TOP_K=2
CHAT_MAX_TOKENS=1000
HYBRID_SEMANTIC_WEIGHT=1.0
HYBRID_LEXICAL_WEIGHT=0.7
HYBRID_RRF_K=60
HYBRID_CANDIDATE_K=24
